NODE_OPTIONS=''
USE_HTTPS=true
NEXT_PUBLIC_DEBUG_MODE=#{NEXT_PUBLIC_DEBUG_MODE}#
NEXT_PUBLIC_APP_ENV=#{NEXT_PUBLIC_APP_ENV}#
NEXT_PUBLIC_APP_VERSION=#{NEXT_PUBLIC_APP_VERSION}#
NEXT_PUBLIC_API_URL=#{NEXT_PUBLIC_API_URL}#
NEXT_PUBLIC_API_TIMEOUT=#{NEXT_PUBLIC_API_TIMEOUT}#
NEXT_TELEMETRY_DISABLED=1

# Microsoft EntraID — PKCE (sin client_secret, flujo browser)
AUTH_URL=#{AUTH_URL}#
NEXT_PUBLIC_MICROSOFT_ENTRA_CLIENT_ID=#{NEXT_PUBLIC_MICROSOFT_ENTRA_CLIENT_ID}#
NEXT_PUBLIC_MICROSOFT_ENTRA_TENANT_ID=#{NEXT_PUBLIC_MICROSOFT_ENTRA_TENANT_ID}#
NEXT_PUBLIC_MICROSOFT_ENTRA_REDIRECT_URI=#{NEXT_PUBLIC_MICROSOFT_ENTRA_REDIRECT_URI}#
