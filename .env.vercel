# ─────────────────────────────────────────────────────────────────────────────
# Entorno Vercel — FULL MOCK DATA (rama demo)
#
# Este archivo se usa ÚNICAMENTE para el despliegue en Vercel de la rama demo.
# No contiene ningún dato real: sin credenciales, sin URLs de backend,
# sin client IDs reales de Azure.
#
# En Vercel: Settings → Environment Variables → importar o copiar estos valores.
# En Azure DevOps (ramas develop/certification/production): seguir usando
# los archivos .env.develop / .env.certification / .env.production con los
# tokens de sustitución #{...}# del pipeline CI/CD.
# ─────────────────────────────────────────────────────────────────────────────

NODE_OPTIONS=''
USE_HTTPS=false
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_APP_VERSION=0.2.0-demo
NEXT_TELEMETRY_DISABLED=1

# ── MOCK AUTH ─────────────────────────────────────────────────────────────────
# Activa el flujo de login instantáneo sin Microsoft Entra.
# El botón "Iniciar sesión" autentica directamente como Administrador Demo.
NEXT_PUBLIC_USE_MOCK_AUTH=true

# ── API URL ficticia ──────────────────────────────────────────────────────────
# Nunca se alcanza: todos los repositorios apuntan a mock en memoria.
# Se necesita para que el FetchHttpClient no falle en construcción.
NEXT_PUBLIC_API_URL=https://mock.spidi.local
NEXT_PUBLIC_API_TIMEOUT=5000

# ── Microsoft Entra (valores ficticios — no se usan con MOCK_AUTH=true) ───────
AUTH_URL=https://tu-app.vercel.app
NEXT_PUBLIC_MICROSOFT_ENTRA_CLIENT_ID=mock-client-id-vercel
NEXT_PUBLIC_MICROSOFT_ENTRA_TENANT_ID=mock-tenant-id-vercel
NEXT_PUBLIC_MICROSOFT_ENTRA_REDIRECT_URI=https://tu-app.vercel.app/validate-token
