NODE_OPTIONS=''
NEXT_PUBLIC_DEBUG_MODE=#{NEXT_DEBBUG_MODE}#
NEXT_PUBLIC_APP_ENV=#{NEXT_APP_ENV}#
NEXT_PUBLIC_APP_VERSION=#{NEXT_APP_VERSION}#
NEXT_PUBLIC_API_URL=#{NEXT_API_URL}#
NEXT_PUBLIC_API_TIMEOUT=#{NEXT_API_TIMEOUT}#
NEXT_TELEMETRY_DISABLED=1

# Microsoft EntraID / next-auth v5
# AUTH_SECRET: genera con `npx auth secret` o usa un string aleatorio de 32+ chars
AUTH_SECRET=#{AUTH_SECRET}#
AUTH_MICROSOFT_ENTRA_ID_ID=#{NEXT_CLIENT_ID}#
AUTH_MICROSOFT_ENTRA_ID_SECRET=#{CLIENT_SECRET}#
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=#{NEXT_TENANT_ID}#
