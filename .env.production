NEXT_PUBLIC_DEBUG_MODE=#{DEBUG_MODE}#
NEXT_PUBLIC_APP_ENV=#{APP_ENV}#
NEXT_PUBLIC_APP_VERSION=#{APP_VERSION}#
NEXT_PUBLIC_API_URL=#{API_URL}#
NEXT_PUBLIC_API_TIMEOUT=#{API_TIMEOUT}#
NEXT_TELEMETRY_DISABLED=1

# Microsoft EntraID / MSAL
NEXT_PUBLIC_TENANT_ID=#{TENANT_ID}#
NEXT_PUBLIC_CLIENT_ID=#{CLIENT_ID}#
NEXT_PUBLIC_AUTHORITY=#{AUTHORITY}#
NEXT_PUBLIC_REDIRECT_URI=#{REDIRECT_URI}#

# Configuración de roles y grupos de AD NO SE USAN, PERO SE DEJAN PARA QUE NO MARQUEN ERROR
# Mapeo de grupos de AD a roles de la app (acepta displayName o GUID del grupo, separados por coma)
NEXT_PUBLIC_ROLE_ADMIN_TI=SPIDI-ADMIN-TI
NEXT_PUBLIC_ROLE_ADMIN_OPERACIONES=SPIDI-ADMIN-OPERACIONES
NEXT_PUBLIC_ROLE_FINANZAS=SPIDI-FINANZAS
NEXT_PUBLIC_ROLE_RH=SPIDI-RH
